<Window x:Class="FakeDataGenerator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fake Data Generator" Height="250" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Number of records:" Margin="0 0 0 5"/>
            <TextBox x:Name="CountTextBox" Text="100" Margin="0 0 0 10"/>

            <TextBlock Text="Export format:" Margin="0 0 0 5"/>
            <ComboBox x:Name="FormatComboBox" SelectedIndex="0">
                <ComboBoxItem>Excel</ComboBoxItem>
                <ComboBoxItem>CSV</ComboBoxItem>
                <ComboBoxItem>JSON</ComboBoxItem>
            </ComboBox>

            <Button Content="Generate and Save" 
                    Click="GenerateButton_Click"
                    Margin="0 20 0 0"
                    Padding="10 5"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>